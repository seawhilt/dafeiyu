{
  "name": "agent-dafeiyu",
  "version": "0.2.2",
  "description": "大肥鱼桌宠：Claude Code 与 DeepSeek Harness 共用的桌面 Agent 状态伴侣，右键切换服务商。",
  "author": "seawhilt",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dafeiyu": "bin/dafeiyu.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./protocol": "./src/protocol.js",
    "./reducer": "./src/companion-reducer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "lib/client.js",
    "lib/settings.html",
    "runtime/helper.py",
    "runtime/animation_model.py",
    "runtime/layout_store.py",
    "runtime/asset_paths.py",
    "runtime/pet_geometry.py",
    "runtime/__init__.py",
    "runtime/bin/",
    "native/macos/",
    "scripts/build-helper.ps1",
    "scripts/build-helper.sh",
    "scripts/build-helper.mjs",
    "scripts/run-python.mjs",
    "scripts/generate_notification_sounds.py",
    "scripts/test-packaged-helper.mjs",
    "assets/pet/",
    "assets/dsh-pet-LICENSE.txt",
    "assets/pet-manifest.json",
    "assets/sounds/",
    "assets/cursor_grab.cur",
    "assets/cursor_grabbing.cur",
    "assets/cursors/",
    "docs/animation-behavior.md",
    "docs/images/",
    "cordis.patch.yml",
    "requirements.txt",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "ASSET_LICENSE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/schemastery": "3.18.4",
    "@standard-schema/spec": "1.1.0"
  },
  "bundleDependencies": [
    "@deepseek-ai/cosmokit",
    "@deepseek-ai/schemastery",
    "@standard-schema/spec"
  ],
  "scripts": {
    "test": "node --test --test-timeout=10000 test/*.test.js",
    "test:helper": "node --test test/helper-lifecycle.test.js",
    "test:python": "node scripts/run-python.mjs -m unittest discover -s runtime/tests -t .",
    "helper:headless": "node scripts/run-python.mjs runtime/helper.py --headless",
    "helper:visual": "node scripts/run-python.mjs runtime/helper.py",
    "build:helper": "node scripts/build-helper.mjs",
    "build:helper:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "build:helper:linux": "bash scripts/build-helper.sh",
    "build:helper:darwin": "bash native/macos/build.sh",
    "test:helper:packaged": "node scripts/test-packaged-helper.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "claude-code",
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "agent-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seawhilt/dafeiyu.git"
  },
  "bugs": {
    "url": "https://github.com/seawhilt/dafeiyu/issues"
  },
  "homepage": "https://github.com/seawhilt/dafeiyu#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
